generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}

enum VehicleType {
  BUS
  ANGKOT
}

model User {
  id        Int      @id @default(autoincrement())
  nama      String
  email     String   @unique
  password  String
  role      String   @default("USER") // Tambahkan ini: USER atau ADMIN
  createdAt DateTime @default(now())
}

model Feedback {
  id        Int      @id @default(autoincrement())
  nama      String
  email     String
  pesan     String   @db.Text
  createdAt DateTime @default(now())
}

model Armada {
  id           Int          @id @default(autoincrement())
  namaArmada   String       // Contoh: "BUS-MJT-001" atau "ANGKOT-F05"
  jenis        VehicleType  // BUS atau ANGKOT
  platNomor    String       @unique
  rute         String
  status       String
  drivers      Driver[]     // Relasi: Satu armada bisa punya beberapa supir (shift)
}

model Driver {
  id           Int      @id @default(autoincrement())
  nama         String
  fotoUrl      String?
  armadaId     Int
  armada       Armada   @relation(fields: [armadaId], references: [id])
  ratings      Rating[]
}

model Rating {
  id        Int      @id @default(autoincrement())
  skor      Int
  komentar  String?  @db.Text
  driverId  Int
  driver    Driver   @relation(fields: [driverId], references: [id])
  createdAt DateTime @default(now())
}

model Laporan {
  id        Int      @id @default(autoincrement())
  judul     String
  masalah   String   @db.Text
  fotoUrl   String   // Nanti isinya: https://[id-cloudfront].cloudfront.net/nama-file.jpg
  namaUser  String
  createdAt DateTime @default(now())
}

model Rute {
  id        Int      @id @default(autoincrement())
  koridor   String   @unique // Contoh: K1, K2
  namaRute  String   // Contoh: Leuwipanjang - Dago
  warna     String   // Contoh: blue, green, yellow
  jamOps    String   @default("05:00 - 21:00 WIB")
}

